// Inventory sorting (name / price / quantity / weight) and restoring the original item order.

#include "InvenFilter.h"

// Sorts the inventory of a side by key (0 name, 1 price, 2 quantity, 3 weight); redraw = redraw
// the inventory afterwards. The original order is saved first (SaveOriginalOrder) so that
// releasing the sort can bring it back. The unequipped items are moved to a temporary container
// while a map is built whose keys are the sort value plus the position (so equal values stay
// unique); the map is then sorted by key (resize_array -2 ascending for names, -3 descending
// for numbers) and the items are added back in two passes: the odd positions from the end, then the
// even positions from the end. The engine appends the items it is given and shows the list in
// reverse, which makes this the order the player sees sorted.
procedure SortInventory(variable side, variable key, variable redraw)
begin
    variable owner;
    variable box;
    variable sortMap;
    variable items;
    variable item;
    variable skipped := 0;
    variable moved := 0;
    variable count;
    variable pos := 0;
    variable total;
    owner := GetInventoryOwner(side);
    if (owner == 0) then begin
        return 0;
    end
    call SaveOriginalOrder(side);
    filterDone := 0;
    box := create_object_sid(PID_TEMP_BOX, 1, 0, 0);
    sortMap := create_array(-1, 0);
    item := InvenItemAt(owner, skipped);
    while (item andAlso (moved < maxItems)) do begin
        if (sfall_func1("get_flags", item) bwand ITEM_FLAGS_EQUIPPED) then begin
            skipped++;
        end
        else begin
            count := rm_mult_objs_from_inven(owner, item, obj_is_carrying_obj(owner, item));
            add_mult_objs_to_inven(box, item, count);
            set_array(sortMap, SortKeyOf(item, key, count, moved), item);
            moved++;
        end
        item := InvenItemAt(owner, skipped);
    end
    if (key == 0) then begin
        resize_array(sortMap, -2);
    end
    else begin
        resize_array(sortMap, -3);
    end
    total := len_array(sortMap);
    items := create_array(total, 0);
    while (pos < total) do begin
        set_array(items, pos, get_array(sortMap, array_key(sortMap, pos)));
        pos++;
    end
    call ReAddInTwoPasses(items, total, box, owner);
    free_array(items);
    free_array(sortMap);
    // Whatever the engine refused to give back (a capacity check) returns to the owner by force
    // instead of being destroyed with the temporary container.
    Trace("Sort leftover=" + sfall_func1("get_current_inven_size", box))
    move_obj_inven_to_obj(box, owner);
    destroy_object(box);
    if (redraw) then begin
        sfall_func1("inventory_redraw", side);
    end
    filterDone := 1;
end

// Key of an item in the sort map: the sort value (the name, the price, the quantity count or the
// weight), then its position so that two items with the same value keep distinct keys.
procedure SortKeyOf(variable item, variable key, variable count, variable position)
begin
    if (key == 0) then begin
        return obj_name(item) + "|" + position;
    end
    if (key == 1) then begin
        return (proto_data(obj_pid(item), PDATA_ITEM_COST) * SORT_KEY_SCALE) + position;
    end
    if (key == 2) then begin
        return (count * SORT_KEY_SCALE) + position;
    end
    return (sfall_func1("item_weight", item) * SORT_KEY_SCALE) + position;
end

// Gives the sorted items back from the temporary container to the owner: first the odd positions
// of the sorted list from the end, then the even ones from the end.
procedure ReAddInTwoPasses(variable items, variable total, variable box, variable owner)
begin
    variable half;
    variable pass;
    variable pos;
    variable index;
    variable item;
    variable amount;
    half := (total + 1) / 2;
    for (pass := 1; pass >= 0; pass--) begin
        pos := half - 1;
        while (pos >= 0) do begin
            index := (pos * 2) + pass;
            if (index < total) then begin
                item := get_array(items, index);
                amount := obj_is_carrying_obj(box, item);
                if (amount > 0) then begin
                    amount := rm_mult_objs_from_inven(box, item, amount);
                    add_mult_objs_to_inven(owner, item, amount);
                end
            end
            pos--;
        end
    end
end

// ---- Original order

// Inventory controlled by a filter window: the player (side 0), or the loot target / barter
// partner (side 1).
procedure GetInventoryOwner(variable side)
begin
    if (side == SIDE_PLAYER) then begin
        return dude_obj;
    end
    if (lootFilter) then begin
        return lootObject;
    end
    return dialogCritter;
end

// Remembers the current item order of a side as a map item -> position + 1. Does nothing if a
// snapshot already exists, so it must be called before a filter or sort first reorders the
// inventory. The map is only ever used as a lookup table: item pointers are never dereferenced.
procedure SaveOriginalOrder(variable side)
begin
    variable owner;
    variable snapshot;
    variable item;
    variable pos := 0;
    if (SideGet(side, SS_SNAPSHOT)) then begin
        return 0;
    end
    owner := GetInventoryOwner(side);
    if (owner == 0) then begin
        return 0;
    end
    snapshot := create_array(-1, 0);
    item := InvenItemAt(owner, pos);
    while (item andAlso (pos < maxItems)) do begin
        set_array(snapshot, item, pos + 1);
        pos++;
        item := InvenItemAt(owner, pos);
    end
    SideSet(side, SS_SNAPSHOT, snapshot);
end

// 1 if the unequipped items of owner already follow the order stored in snapshot, the items it
// does not know coming last, which is exactly the order RestoreOriginalOrder would build. A filter
// that only hides items leaves the rest in order, so most of the time nothing has to be moved.
procedure OrderMatchesSnapshot(variable owner, variable snapshot)
begin
    variable pos := 0;
    variable seen := 0;
    variable rank;
    variable lastRank := 0;
    variable unknownRank;
    variable item;
    unknownRank := len_array(snapshot) + 1;
    item := InvenItemAt(owner, pos);
    while (item andAlso (seen < maxItems)) do begin
        if (not(sfall_func1("get_flags", item) bwand ITEM_FLAGS_EQUIPPED)) then begin
            rank := get_array(snapshot, item);
            if (rank == 0) then begin
                rank := unknownRank;
            end
            if (rank < lastRank) then begin
                return 0;
            end
            lastRank := rank;
            seen++;
        end
        pos++;
        item := InvenItemAt(owner, pos);
    end
    return 1;
end

// Puts the unequipped items of a side back in the order stored by SaveOriginalOrder (redraw =
// redraw afterwards). Items missing from the snapshot (new, or recreated like the caps stack)
// go after the known ones, in their current order. The engine appends added items, so the
// order in which they are re-added is the final inventory order. Nothing is moved when the
// items are already in that order (OrderMatchesSnapshot).
procedure RestoreOriginalOrder(variable side, variable redraw)
begin
    variable owner;
    variable snapshot;
    variable temp;
    variable ordered;
    variable item;
    variable pos := 0;
    variable moved := 0;
    variable rank;
    variable amount;
    variable unknownRank;
    owner := GetInventoryOwner(side);
    snapshot := SideGet(side, SS_SNAPSHOT);
    if ((owner == 0) orElse (snapshot == 0)) then begin
        if (redraw) then begin
            sfall_func1("inventory_redraw", side);
        end
        return 0;
    end
    if (OrderMatchesSnapshot(owner, snapshot)) then begin
        if (redraw) then begin
            sfall_func1("inventory_redraw", side);
        end
        return 0;
    end
    filterDone := 0;
    temp := create_object_sid(PID_TEMP_BOX, 1, 0, 0);
    ordered := create_array(-1, 0);
    unknownRank := len_array(snapshot) + 1;
    item := InvenItemAt(owner, pos);
    while (item andAlso (moved < maxItems)) do begin
        if (sfall_func1("get_flags", item) bwand ITEM_FLAGS_EQUIPPED) then begin
            pos++;
        end
        else begin
            rank := get_array(snapshot, item);
            if (rank == 0) then begin
                rank := unknownRank;
            end
            amount := rm_mult_objs_from_inven(owner, item, obj_is_carrying_obj(owner, item));
            add_mult_objs_to_inven(temp, item, amount);
            set_array(ordered, (rank * SORT_KEY_SCALE) + moved, item);
            moved++;
        end
        item := InvenItemAt(owner, pos);
    end
    resize_array(ordered, -2);
    moved := len_array(ordered);
    pos := 0;
    while (pos < moved) do begin
        item := get_array(ordered, array_key(ordered, pos));
        amount := obj_is_carrying_obj(temp, item);
        if (amount > 0) then begin
            amount := rm_mult_objs_from_inven(temp, item, amount);
            add_mult_objs_to_inven(owner, item, amount);
        end
        pos++;
    end
    free_array(ordered);
    Trace("Restore side=" + side + " moved=" + moved + " leftover=" + sfall_func1("get_current_inven_size", temp))
    move_obj_inven_to_obj(temp, owner);
    destroy_object(temp);
    if (redraw) then begin
        sfall_func1("inventory_redraw", side);
    end
    filterDone := 1;
end

// Drops the saved order of a side.
procedure FreeOriginalOrder(variable side)
begin
    if (SideGet(side, SS_SNAPSHOT)) then begin
        free_array(SideGet(side, SS_SNAPSHOT));
        SideSet(side, SS_SNAPSHOT, 0);
    end
end

// Applies the order a side should currently show: the active sort mode, or its original order
// when no sort is on. The snapshot is dropped once neither a filter nor a sort is active.
procedure ApplyInventoryOrder(variable side, variable redraw)
begin
    variable sortMode;
    sortMode := SideGet(side, SS_SORT);
    if (sortMode) then begin
        call SortInventory(side, sortMode - 1, redraw);
    end
    else begin
        call RestoreOriginalOrder(side, redraw);
        if (SideGet(side, SS_FLAGS) == 0) then begin
            call FreeOriginalOrder(side);
        end
    end
end
